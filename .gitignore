# Тяжёлые бинарные веса моделей в assets и APK скачиваются/собираются скриптом
# (APK выкладывается в Releases или artifacts/neuro-stenograf-release.apk при необходимости)
src/android/app/src/main/assets/models/asr/*.onnx
src/android/app/src/main/assets/models/diarization/*.onnx
src/android/app/src/main/assets/models/vad/*.onnx
src/android/app/src/main/assets/models/denoise/*.onnx
src/android/app/src/main/assets/llm/*.litertlm
src/android/app/libs/*.aar
artifacts/demo/*.apk
